+// the stylesheets embedded in every rendered svg; fetched once per page instead of per render
+let cssCache: pxt.Map<Promise<string>>;
+function loadCssAsync(href: string): Promise<string> {
+    if (!cssCache) cssCache = {};
+    if (!cssCache[href]) {
